{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "instatools-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "browser": {
    "binding": "BROWSER"
  },
  // Production KV for apps, keys, and designs.
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "3464901f98e24c6e82a9b40c91928062"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/v1/*",
      "/",
      "/robots.txt",
      "/render",
      "/render.html"
    ]
  },
  "vars": {
    "BOOTSTRAP_APP_NAME": "instatools-testing",
    "RENDER_ORIGIN": ""
  }
}
